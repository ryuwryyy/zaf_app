# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Firebase service account key (sensitive - do not commit)
google-service-account-key.json
*firebase*service*account*.json
*-firebase-adminsdk-*.json

# Secrets and local env (never commit real tokens)
.env
.env.*
!.env.example

# Campaign sender logs (may contain token fragments / diagnostics)
logs/

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android