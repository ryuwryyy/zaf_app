# Copy to `.env` in the project root. `npm run send-campaigns` loads this file automatically.
# Never commit real values.

# Expo: https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=

# Path to Firebase **service account** JSON (not google-services.json).
# Use a full path on Windows, e.g. D:\secure\odza-firebase-adminsdk.json
# Name must be GOOGLE_APPLICATION_CREDENTIALS (ends with S).
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: raw JSON for CI (single line). Prefer file path when possible.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: append ISO-timestamped logs to this file (relative to repo root)
# CAMPAIGN_LOG_FILE=logs/campaign-run.log

# Receipt polling (Expo recommends checking receipts; receipts may lag)
# EXPO_RECEIPT_POLL_INTERVAL_MS=4000
# EXPO_RECEIPT_MAX_WAIT_MS=120000
